% Family database

male(john).
male(david).
male(rahul).

female(mary).
female(priya).
female(anitha).

parent(john, david).
parent(mary, david).
parent(john, priya).
parent(mary, priya).
parent(david, rahul).
parent(anitha, rahul).

% Father
father(X, Y) :-
    male(X),
    parent(X, Y).

% Mother
mother(X, Y) :-
    female(X),
    parent(X, Y).

% Brother
brother(X, Y) :-
    male(X),
    parent(P, X),
    parent(P, Y),
    X \= Y.

% Sister
sister(X, Y) :-
    female(X),
    parent(P, X),
    parent(P, Y),
    X \= Y.

% Grandparent
grandparent(X, Y) :-
    parent(X, Z),
    parent(Z, Y).
