# Map Coloring using CSP (Backtracking)

# Function to check if it is safe to assign a color
def is_safe(node, color, assignment, graph):
    for neighbor in graph[node]:
        if neighbor in assignment and assignment[neighbor] == color:
            return False
    return True

# Backtracking function
def map_coloring(graph, colors, assignment, nodes):
    if len(assignment) == len(nodes):
        return assignment

    # Select an unassigned node
    node = next(n for n in nodes if n not in assignment)

    # Try each color
    for color in colors:
        if is_safe(node, color, assignment, graph):
            assignment[node] = color

            result = map_coloring(graph, colors, assignment, nodes)
            if result:
                return result

            # Backtrack
            del assignment[node]

    return None

# Graph representation (Australia Map)
graph = {
    'WA': ['NT', 'SA'],
    'NT': ['WA', 'SA', 'Q'],
    'SA': ['WA', 'NT', 'Q', 'NSW', 'V'],
    'Q': ['NT', 'SA', 'NSW'],
    'NSW': ['Q', 'SA', 'V'],
    'V': ['SA', 'NSW'],
    'T': []   # Tasmania has no adjacent states
}

# Available colors
colors = ['Red', 'Green', 'Blue']

# Solve the CSP
assignment = {}
nodes = list(graph.keys())

solution = map_coloring(graph, colors, assignment, nodes)

# Display the result
if solution:
    print("Map Coloring Solution:")
    for state, color in solution.items():
        print(f"{state} --> {color}")
else:
    print("No solution exists.")
