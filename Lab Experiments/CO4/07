# Genetic Algorithm to maximize f(x) = x^2

import random

# Fitness function
def fitness(x):
    return x * x

# Initial population
population = [random.randint(0, 31) for _ in range(6)]

for generation in range(10):

    # Calculate fitness
    population.sort(key=fitness, reverse=True)

    # Select best two
    parent1 = population[0]
    parent2 = population[1]

    # Crossover
    child = (parent1 + parent2) // 2

    # Mutation
    if random.random() < 0.1:
        child = random.randint(0, 31)

    # Replace weakest solution
    population[-1] = child

    print("Generation", generation + 1,
          "Best =", population[0],
          "Fitness =", fitness(population[0]))

print("\nOptimal Solution:", population[0])
print("Maximum Fitness:", fitness(population[0]))
